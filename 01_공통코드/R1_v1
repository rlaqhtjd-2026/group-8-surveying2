}).copy()
field['Sample_Date'] = pd.to_datetime(field['Sample_Date'], errors='coerce').dt.normalize()
field['Chl_a'] = pd.to_numeric(field['Chl_a'], errors='coerce')
field = field.dropna(subset=['Sample_Date', 'Chl_a'])
field = field.loc[field['Sample_Date'].between(START_DATE, END_DATE)].copy()
for year, month in EXCLUDE_MONTHS:
    field = field.loc[~((field.Sample_Date.dt.year == year) &
                        (field.Sample_Date.dt.month == month))].copy()
field = field.sort_values('Sample_Date').reset_index(drop=True)

if field.empty:
    raise ValueError('No field observations remain.')
if field.Sample_Date.duplicated().any():
    duplicates = field.loc[field.Sample_Date.duplicated(False), 'Sample_Date']
    raise ValueError(f'Duplicate sampling dates: {duplicates.dt.date.tolist()}')

field.insert(0, 'Field_ID', np.arange(1, len(field) + 1))
field['Year'] = field.Sample_Date.dt.year
field['Month'] = field.Sample_Date.dt.month
field['Site'] = np.where(field.Sample_Date < pd.Timestamp(NEW_SITE_START), 'Old', 'New')
field['Longitude'] = field.Site.map({k: v[0] for k, v in SITES.items()})
field['Latitude'] = field.Site.map({k: v[1] for k, v in SITES.items()})
print('Field observations:', len(field))

rois = {
    site: ee.Geometry.Point([lon, lat]).buffer(BUFFER_M)
    for site, (lon, lat) in SITES.items()
}
reducer = ee.Reducer.mean().combine(reducer2=ee.Reducer.count(), sharedInputs=True)


def extract_scene(image, roi):
    image = ee.Image(image)
    scl = image.select('SCL')
    clear = (scl.eq(0).Or(scl.eq(1)).Or(scl.eq(3))
             .Or(scl.eq(8)).Or(scl.eq(9)).Or(scl.eq(10)).Or(scl.eq(11))).Not()
    water = scl.eq(6)
    b4 = image.select('B4').multiply(0.0001)
    b5 = image.select('B5').multiply(0.0001)
    valid = clear.And(b4.gte(0)).And(b5.gte(0)).And(b4.add(b5).gt(0))
    ndci = b5.subtract(b4).divide(b5.add(b4)).rename('NDCI').updateMask(valid)

    stack = ee.Image.cat([
        ndci,
        b4.rename('B4').updateMask(valid),
        b5.rename('B5').updateMask(valid),
        ndci.updateMask(water).rename('Water_NDCI'),
        b5.eq(0).rename('B5Zero').updateMask(valid),
        clear.rename('Clear'),
        water.rename('Water'),
    ])
    s = stack.reduceRegion(
        reducer=reducer,
        geometry=roi,
        crs=image.select('B5').projection(),
        scale=20,
        maxPixels=100000,
        tileScale=2,
    )
    return ee.Feature(None, {
        'Image_ID': image.get('system:index'),
        'Satellite_Date': image.date().format('YYYY-MM-dd', 'Asia/Seoul'),
        'Cloud_Percent_Global': image.get('CLOUDY_PIXEL_PERCENTAGE'),
        'NDCI': s.get('NDCI_mean'),
        'NDCI_Pixels': s.get('NDCI_count'),
        'B4_Mean': s.get('B4_mean'),
        'B5_Mean': s.get('B5_mean'),
        'Water_NDCI': s.get('Water_NDCI_mean'),
        'Water_Pixels': s.get('Water_NDCI_count'),
        'B5Zero_Fraction': s.get('B5Zero_mean'),
        'Local_Clear_Fraction': s.get('Clear_mean'),
        'Local_Water_Fraction': s.get('Water_mean'),
    })


scene_rows = []
for (year, site), samples in field.groupby(['Year', 'Site'], sort=True):
    dates = sorted(samples.Sample_Date.dt.strftime('%Y-%m-%d').unique().tolist())
    for offset in range(0, len(dates), BATCH_SIZE):
        group_dates = dates[offset:offset + BATCH_SIZE]
        lower = (pd.Timestamp(group_dates[0]) - pd.Timedelta(days=1)).strftime('%Y-%m-%d')
        upper = (pd.Timestamp(group_dates[-1]) + pd.Timedelta(days=2)).strftime('%Y-%m-%d')
        roi = rois[site]
        images = (ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
                  .filterBounds(roi)
                  .filterDate(lower, upper)
                  .map(lambda img: ee.Image(img).set(
                      'KST_Date', ee.Image(img).date().format('YYYY-MM-dd', 'Asia/Seoul')))
                  .filter(ee.Filter.inList('KST_Date', group_dates)))
        count = int(images.size().getInfo())
        if count:
            features = ee.FeatureCollection(
                images.toList(count).map(lambda img: extract_scene(img, roi))
            ).getInfo()['features']
            for feature in features:
                scene_rows.append({**feature['properties'], 'Site': site, 'Year': year})
    print(f'{year} {site}: {len(dates)} field dates')

if not scene_rows:
    raise RuntimeError('No same-day Sentinel-2 scenes found.')

scenes = pd.DataFrame(scene_rows).drop_duplicates(['Site', 'Image_ID']).copy()
scenes['Satellite_Date'] = pd.to_datetime(scenes['Satellite_Date']).dt.normalize()
for c in ['Cloud_Percent_Global', 'NDCI', 'NDCI_Pixels', 'B4_Mean', 'B5_Mean',
          'Water_NDCI', 'Water_Pixels', 'B5Zero_Fraction',
          'Local_Clear_Fraction', 'Local_Water_Fraction']:
    if c not in scenes:
        scenes[c] = np.nan
    scenes[c] = pd.to_numeric(scenes[c], errors='coerce')

scenes['QA_Pass'] = (
    scenes.NDCI.notna()
    & scenes.NDCI_Pixels.ge(MIN_NDCI_PIXELS)
    & scenes.Local_Clear_Fraction.ge(MIN_CLEAR_FRACTION)
    & scenes.Water_Pixels.ge(MIN_WATER_PIXELS)
)
scenes = scenes.sort_values(['Satellite_Date', 'Site', 'Image_ID']).reset_index(drop=True)

selected = (scenes.loc[scenes.QA_Pass]
            .sort_values(['Site', 'Satellite_Date', 'NDCI_Pixels',
                          'Local_Clear_Fraction', 'Cloud_Percent_Global', 'Image_ID'],
                         ascending=[True, True, False, False, True, True])
            .drop_duplicates(['Site', 'Satellite_Date'])
            .copy())

joined = field.merge(
    selected.drop(columns=['Year']),
    left_on=['Sample_Date', 'Site'],
    right_on=['Satellite_Date', 'Site'],
    how='left', validate='one_to_one',
)
joined['Matched'] = joined.NDCI.notna()
matched = joined.loc[joined.Matched].copy()
if not (matched.Sample_Date == matched.Satellite_Date).all():
    raise AssertionError('Same-day matching failed.')
print('Matched observations:', len(matched))


def statistics(df, label):
    part = df[['NDCI', 'Chl_a']].dropna()
    n = len(part)
    row = {
        'Period': label, 'N': n, 'Pearson_r': np.nan, 'Pearson_p': np.nan,
        'Spearman_rho': np.nan, 'R2_in_sample': np.nan,
        'Slope': np.nan, 'Intercept': np.nan, 'RMSE_in_sample': np.nan,
    }
    if n >= 3 and part.NDCI.nunique() >= 2 and part.Chl_a.nunique() >= 2:
        x = part.NDCI.to_numpy(dtype=float)
        y = part.Chl_a.to_numpy(dtype=float)
        r, p = pearsonr(x, y)
        rho, _ = spearmanr(x, y)
        slope, intercept = np.polyfit(x, y, 1)
        row.update({
            'Pearson_r': float(r), 'Pearson_p': float(p),
            'Spearman_rho': float(rho), 'R2_in_sample': float(r * r),
            'Slope': float(slope), 'Intercept': float(intercept),
            'RMSE_in_sample': float(np.sqrt(np.mean((y - (slope * x + intercept)) ** 2))),
        })
    return row


# 1) 전체기간 및 5~9월 상관분석·회귀분석
may_sep = matched.loc[matched.Month.between(5, 9)].copy()
summary = pd.DataFrame([
    statistics(matched, '2021-2026Sep_All'),
    statistics(may_sep, '2021-2026Sep_MaySep'),
])

# 2) 5~9월 회귀모형의 LOYO(Leave-One-Year-Out) 교차검증
# 각 연도의 모든 표본을 검증용으로 제외하고, 나머지 연도만으로 회귀식을 새로 학습함.
# 최종 공간분석용 회귀식은 위 summary에 있는 'MaySep' 전체자료 회귀식임.
loyo_predictions = []
loyo_by_year = []

for held_out_year in sorted(may_sep.Year.unique()):
    train = may_sep.loc[may_sep.Year.ne(held_out_year)].copy()
    test = may_sep.loc[may_sep.Year.eq(held_out_year)].copy()
    if (len(train) < 3 or train.NDCI.nunique() < 2
            or train.Chl_a.nunique() < 2):
        raise ValueError(f'LOYO {held_out_year}: insufficient training data.')

    slope, intercept = np.polyfit(
        train.NDCI.to_numpy(dtype=float),
        train.Chl_a.to_numpy(dtype=float), 1
    )
    predicted = slope * test.NDCI.to_numpy(dtype=float) + intercept
    observed = test.Chl_a.to_numpy(dtype=float)
    error = predicted - observed  # (+) 과대추정, (-) 과소추정

    fold_df = test[['Field_ID', 'Sample_Date', 'Year', 'Site', 'NDCI', 'Chl_a']].copy()
    fold_df = fold_df.rename(columns={'Chl_a': 'Observed_Chl_a'})
    fold_df['Predicted_Chl_a_LOYO'] = predicted
    fold_df['Error_Pred_minus_Obs'] = error
    fold_df['Abs_Error'] = np.abs(error)
    fold_df['Held_Out_Year'] = held_out_year
    fold_df['Train_N'] = len(train)
    loyo_predictions.append(fold_df)

    # 연도별 R²은 검증값이 2개 이상이고 변동이 있을 때만 계산 가능함.
    fold_sst = np.sum((observed - np.mean(observed)) ** 2)
    fold_r2 = (1 - np.sum(error ** 2) / fold_sst
               if len(test) >= 2 and fold_sst > 0 else np.nan)
    loyo_by_year.append({
        'Held_Out_Year': int(held_out_year),
        'Train_N': len(train), 'Test_N': len(test),
        'Train_Slope': float(slope), 'Train_Intercept': float(intercept),
        'R2_LOYO_Fold': float(fold_r2),
        'RMSE_LOYO_Fold': float(np.sqrt(np.mean(error ** 2))),
        'MAE_LOYO_Fold': float(np.mean(np.abs(error))),
        'Bias_LOYO_Fold': float(np.mean(error)),
    })

if not loyo_predictions:
    raise ValueError('No 5–9월 matched observations available for LOYO.')

loyo_predictions = pd.concat(loyo_predictions, ignore_index=True)
loyo_predictions = loyo_predictions.sort_values(['Sample_Date', 'Field_ID']).reset_index(drop=True)
loyo_by_year = pd.DataFrame(loyo_by_year)

# 모든 제외 연도의 검증 예측값을 합쳐 전체 교차검증 성능 계산
obs = loyo_predictions.Observed_Chl_a.to_numpy(dtype=float)
pred = loyo_predictions.Predicted_Chl_a_LOYO.to_numpy(dtype=float)
resid = pred - obs
sst = np.sum((obs - obs.mean()) ** 2)
loyo_summary = pd.DataFrame([{
    'Period': '2021-2026Sep_MaySep_LOYO',
    'N': len(obs), 'N_Held_Out_Years': loyo_by_year.shape[0],
    'R2_LOYO': float(1 - np.sum(resid ** 2) / sst) if sst > 0 else np.nan,
    'RMSE_LOYO': float(np.sqrt(np.mean(resid ** 2))),
    'MAE_LOYO': float(np.mean(np.abs(resid))),
    'Bias_LOYO': float(np.mean(resid)),
}])
assert len(loyo_predictions) == len(may_sep), 'LOYO predictions must cover all May–Sep samples.'

coverage = field.groupby(['Year', 'Month']).size().rename('Field_N').reset_index()
matched_monthly = matched.groupby(['Year', 'Month']).size().rename('Matched_N').reset_index()
